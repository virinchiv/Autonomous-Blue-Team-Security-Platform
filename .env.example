# AION - Autonomous Blue Team Security Platform
# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# =============================================================================
# REQUIRED: Groq API Configuration
# =============================================================================
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# =============================================================================
# Elasticsearch Configuration
# =============================================================================
# Elasticsearch connection details
ELASTICSEARCH_HOST=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_SSL_VERIFY=true

# Index names for log storage and incidents
UNIFIED_LOGS_INDEX=unified-logs
INCIDENTS_INDEX=aion-incidents

# =============================================================================
# Processing Configuration
# =============================================================================
# Batch size for processing logs (default: 1000)
BATCH_SIZE=1000

# Processing interval in seconds for real-time mode (default: 30)
LOOP_DELAY_SECONDS=30

# Maximum number of logs to process in demo mode (default: 2000)
MAX_DEMO_LOGS=2000

# Maximum number of Tier 3 LLM escalations per batch (default: 50)
MAX_TIER3_ESCALATIONS=50

# =============================================================================
# Security Configuration
# =============================================================================
# Time window for correlating related events (seconds, default: 300 = 5 minutes)
CORRELATION_TIME_WINDOW=300

# =============================================================================
# Logging Configuration
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path (optional, defaults to console output)
LOG_FILE=

# =============================================================================
# Optional: Advanced Configuration
# =============================================================================
# Custom model for Groq LLM analysis (default: llama-3.1-8b-instant)
GROQ_MODEL=llama-3.1-8b-instant

# Temperature for LLM analysis (0.0-1.0, default: 0.2)
GROQ_TEMPERATURE=0.2

# Maximum tokens for LLM responses (default: 350 for analysis, 800 for reports)
GROQ_MAX_TOKENS_ANALYSIS=350
GROQ_MAX_TOKENS_REPORT=800
